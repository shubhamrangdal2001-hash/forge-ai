# Copy this file to .env.production and fill every CHANGE_ME value before deploy.

# Public edge
DOMAIN=forge.example.com
CORS_ORIGINS=https://forge.example.com
ALLOWED_HOSTS=forge.example.com

# Database and service credentials
POSTGRES_USER=forge
POSTGRES_PASSWORD=CHANGE_ME_STRONG_POSTGRES_PASSWORD
POSTGRES_DB=forge
DATABASE_URL=postgresql+asyncpg://forge:CHANGE_ME_STRONG_POSTGRES_PASSWORD@postgres:5432/forge
REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=CHANGE_ME_STRONG_NEO4J_PASSWORD
JWT_SECRET=CHANGE_ME_64_CHAR_RANDOM_SECRET

# Same-origin defaults work behind Caddy. Only set these when the API/WS live on
# a different public host.
NEXT_PUBLIC_API_BASE=
NEXT_PUBLIC_WS_BASE=

# Optional model providers. Leave blank to hide/skip unconfigured providers.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=
COHERE_API_KEY=
KIMI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
MISTRAL_API_KEY=
SARVAM_API_KEY=
KRUTRIM_API_KEY=
TWO_API_KEY=
PERPLEXITY_API_KEY=
GROQ_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
OPENROUTER_API_KEY=

# Optional local model endpoints reachable from containers.
OLLAMA_BASE_URL=http://host.docker.internal:11434
LMSTUDIO_BASE_URL=http://host.docker.internal:1234/v1

# Sandbox image used by the worker when running verification commands.
SANDBOX_IMAGE=forge-sandbox:latest
