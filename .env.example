# ============================================================================
# MODELS — Forge is model-agnostic. Set keys ONLY for the providers you want;
# the user picks any of them per agent role in the IDE. Anything without a key
# is simply skipped by the router. With no cloud keys at all, run "Local only"
# mode (Ollama) for a fully offline, zero-cost setup.
# ============================================================================

# ---- United States ----
ANTHROPIC_API_KEY=sk-ant-xxxxx      # Claude Opus 4.8 / Sonnet 4.5 / Haiku
OPENAI_API_KEY=sk-xxxxx             # GPT-5 / GPT-5 mini / GPT-4.1 / o4-mini
GOOGLE_API_KEY=xxxxx                # Gemini 2.5 Pro / Flash
XAI_API_KEY=xxxxx                   # Grok Code / Grok 4
COHERE_API_KEY=xxxxx                # Command A

# ---- China ----
KIMI_API_KEY=xxxxx                  # Moonshot Kimi K2
DEEPSEEK_API_KEY=xxxxx              # DeepSeek V3 / R1
DASHSCOPE_API_KEY=xxxxx             # Alibaba Qwen2.5 Coder

# ---- Europe ----
MISTRAL_API_KEY=xxxxx               # Mistral Large / Codestral

# ---- India ----
SARVAM_API_KEY=xxxxx                # Sarvam-M (Indic multilingual + coding)
KRUTRIM_API_KEY=xxxxx               # Ola Krutrim-2
TWO_API_KEY=xxxxx                   # TWO AI SUTRA-V2 (Indic multilingual)
PERPLEXITY_API_KEY=xxxxx            # Perplexity Sonar Pro / Sonar Reasoning

# ---- Inference gateways (fast / cheap / any model) ----
GROQ_API_KEY=xxxxx                  # Llama 3.3 70B and others (ultra-fast)
TOGETHER_API_KEY=xxxxx              # Llama 4 Maverick and 100+ OSS models
FIREWORKS_API_KEY=xxxxx             # OSS models
OPENROUTER_API_KEY=xxxxx            # one key -> almost any model worldwide

# ---- Local (no key needed) ----
OLLAMA_BASE_URL=http://localhost:11434     # Qwen2.5 Coder / DeepSeek / Llama, on-device
LMSTUDIO_BASE_URL=http://localhost:1234/v1 # LM Studio OpenAI-compatible server

# ---- Datastores ----
DATABASE_URL=postgresql+asyncpg://forge:forge@localhost:5432/forge
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=forgepass

# ---- App ----
GATEWAY_PORT=8000
JWT_SECRET=change-me
SANDBOX_IMAGE=forge-sandbox:latest
